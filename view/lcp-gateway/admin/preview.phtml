<?php
$escape = $this->plugin('escapeHtml');
$this->htmlElement('body')->appendAttribute('class', 'lcp-gateway-admin');

// Raccogli tutti i contesti configurati nei profili
$availableContexts = [];
foreach ($profiles as $p) {
    $c = strtolower(trim($p['context'] ?? $p['profile_target'] ?? 'default'));
    if ($c && !in_array($c, $availableContexts)) {
        $availableContexts[] = $c;
    }
}
if (!in_array('default', $availableContexts)) array_unshift($availableContexts, 'default');
if (!in_array('web', $availableContexts)) $availableContexts[] = 'web';
if (!in_array('engine', $availableContexts)) $availableContexts[] = 'engine';
?>

