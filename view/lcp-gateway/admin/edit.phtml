        </div>

        <div id="prop_search_results" style="padding: 10px 20px; overflow-y: auto; flex: 1;">
            <!-- Popolato dinamicamente -->
        </div>

        <div style="padding: 12px 20px; background: #f8f8f8; border-top: 1px solid #ddd; text-align: right;">
            <button type="button" id="btn_close_modal_footer" class="button button-secondary" style="padding: 6px 16px;">Chiudi</button>
        </div>
    </div>
