<script>
document.addEventListener('DOMContentLoaded', function () {
    const resourceTemplates = <?php echo json_encode($resourceTemplates, JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP); ?>;
    const allProperties = <?php echo json_encode($allProperties, JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP); ?>;
    let currentFields = <?php echo json_encode($profile['fields'] ?? new \stdClass(), JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP); ?>;
    if (Array.isArray(currentFields)) {
        currentFields = {};
    }

    const isNew = <?php echo $isNew ? 'true' : 'false'; ?>;
    const rcSelect = document.getElementById('resource_class');
    const templateStatusContent = document.getElementById('template_status_content');
    const templatePickerContainer = document.getElementById('template_picker_container');
    const templatePickerSelect = document.getElementById('template_picker_select');
    const fieldsTbody = document.getElementById('fields_tbody');
    const fieldsJsonInput = document.getElementById('fields_json');
    const hiddenFieldInputs = document.getElementById('hidden_field_inputs');

    const modal = document.getElementById('prop_search_modal');
    const searchInput = document.getElementById('prop_search_input');
    const searchResults = document.getElementById('prop_search_results');
    const propTotalBadge = document.getElementById('prop_total_badge');

    if (propTotalBadge) {
        propTotalBadge.textContent = `${allProperties.length} proprietà disponibili in Omeka S`;
    }

    // Mappa veloce per trovare label da termine
    const propertyMap = {};
    allProperties.forEach(p => {
        propertyMap[p.term] = p.label || p.term;
    });

    // Sincronizza stato JSON e campi nascosti
    function syncFields() {
        fieldsJsonInput.value = JSON.stringify(currentFields);
        
        let html = '';
        Object.entries(currentFields).forEach(([term, label]) => {
            html += `<input type="hidden" name="field_terms[]" value="${escapeHtml(term)}">`;
            html += `<input type="hidden" name="field_labels[]" value="${escapeHtml(label)}">`;
        });
        hiddenFieldInputs.innerHTML = html;
        renderFieldsTable();
    }

    function renderFieldsTable() {
        const terms = Object.keys(currentFields);
        if (terms.length === 0) {
            fieldsTbody.innerHTML = `
                <tr>
                    <td colspan="4" style="padding: 24px; text-align: center; color: #888;">
                        <em>Nessun campo selezionato. Fai click su <strong>+ Aggiungi Campo</strong> per selezionare proprietà da Omeka.</em>
                    </td>
                </tr>
            `;
            return;
        }

        let rows = '';
        terms.forEach((term, idx) => {
            const label = currentFields[term] || propertyMap[term] || term;
            rows += `
                <tr style="border-bottom: 1px solid #eee;">
                    <td style="padding: 8px; color: #888; font-size: 12px;">${idx + 1}</td>
                    <td style="padding: 8px;">
                        <code style="font-weight: bold; color: #1e3a8a;">${escapeHtml(term)}</code>
                    </td>
                    <td style="padding: 8px;">
                        <span style="font-weight: 600; color: #333;">${escapeHtml(label)}</span>
                    </td>
                    <td style="padding: 8px; text-align: right;">
                        <button type="button" class="button button-delete" data-term="${escapeHtml(term)}" style="padding: 3px 8px; font-size: 11px;">
                            &times; Rimuovi
                        </button>
                    </td>
                </tr>
            `;
        });
        fieldsTbody.innerHTML = rows;

        // Listener rimozione
        fieldsTbody.querySelectorAll('.button-delete').forEach(btn => {
            btn.addEventListener('click', function () {
                const term = this.getAttribute('data-term');
                delete currentFields[term];
                syncFields();
            });
        });
    }

    // Gestione Selezione Resource Class e corrispondenti Templates (Step 1 e Step 2)
    function onResourceClassChange(isManualChange = false) {
        const selectedOption = rcSelect.options[rcSelect.selectedIndex];
        const selectedTerm = rcSelect.value;
        const selectedId = selectedOption ? parseInt(selectedOption.getAttribute('data-id'), 10) : null;

        if (selectedTerm === '*') {
            templateStatusContent.innerHTML = '<em>Profilo generico (*): nessun template associato. Inizia con una lista vuota o aggiungi proprietà manualmente.</em>';
            templatePickerContainer.style.display = 'none';
            if (isManualChange && Object.keys(currentFields).length === 0) {
                syncFields();
            }
            return;
        }

        // Cerca template corrispondenti per termine o id
        const matchedTemplates = resourceTemplates.filter(t => {
            if (selectedTerm && t.resource_class_term && t.resource_class_term.toLowerCase() === selectedTerm.toLowerCase()) {
                return true;
            }
            if (selectedId && t.resource_class_id === selectedId) {
                return true;
            }
            return false;
        });

        if (matchedTemplates.length === 0) {
            templateStatusContent.innerHTML = `<span style="color: #666;">ℹ️ Nessun Resource Template associato alla classe <code>${escapeHtml(selectedTerm)}</code>. La lista dei campi parte vuota: usa il pulsante sottostante per aggiungere i campi.</span>`;
            templatePickerContainer.style.display = 'none';
            if (isManualChange && isNew) {
                currentFields = {};
                syncFields();
            }
        } else if (matchedTemplates.length === 1) {
            const tmpl = matchedTemplates[0];
            templateStatusContent.innerHTML = `
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <div>
                        <strong style="color: #0d47a1;">✓ Resource Template trovato:</strong>
                        <span>${escapeHtml(tmpl.label)}</span>
                        <span style="color: #666; font-size: 11px;">(${tmpl.properties.length} proprietà di base)</span>
                    </div>
                    <button type="button" id="btn_reload_single_template" class="button button-secondary" style="padding: 3px 8px; font-size: 11px;">
                        Carica proprietà dal template
                    </button>
                </div>
            `;
            templatePickerContainer.style.display = 'none';

            document.getElementById('btn_reload_single_template').addEventListener('click', function () {
                loadPropertiesFromTemplate(tmpl);
            });

            // Se è un nuovo profilo appena iniziato, carica subito i campi di base
            if (isManualChange && isNew && Object.keys(currentFields).length === 0) {
                loadPropertiesFromTemplate(tmpl);
            }
        } else {
            // Più di un template disponibile
            templateStatusContent.innerHTML = `
                <strong style="color: #e65100;">Trovati ${matchedTemplates.length} Resource Template per questa classe.</strong>
                <span style="color: #666;">Seleziona da quale template partire per precompilare le proprietà:</span>
            `;
            templatePickerContainer.style.display = 'block';

            let optionsHtml = '<option value="">-- Seleziona un Template --</option>';
            optionsHtml += '<option value="__empty__">-- Nessun template (lista vuota) --</option>';
            matchedTemplates.forEach(t => {
                optionsHtml += `<option value="${t.id}">${escapeHtml(t.label)} (${t.properties.length} proprietà)</option>`;
            });
            templatePickerSelect.innerHTML = optionsHtml;
        }
    }

    templatePickerSelect.addEventListener('change', function () {
        const val = this.value;
        if (!val) return;
        if (val === '__empty__') {
            currentFields = {};
            syncFields();
            return;
        }
        const selectedId = parseInt(val, 10);
        const tmpl = resourceTemplates.find(t => t.id === selectedId);
        if (tmpl) {
            loadPropertiesFromTemplate(tmpl);
        }
    });

    function loadPropertiesFromTemplate(tmpl) {
        currentFields = {};
        tmpl.properties.forEach(p => {
            currentFields[p.term] = p.label || p.term;
        });
        syncFields();
    }

    rcSelect.addEventListener('change', function () {
        onResourceClassChange(true);
    });

    // Inizializza visualizzazione template e tabella campi al caricamento
    onResourceClassChange(false);
    renderFieldsTable();

    // MODAL DI RICERCA PROPRIETÀ
    function openModal() {
        modal.style.display = 'flex';
        searchInput.value = '';
        renderSearchResults('');
        setTimeout(() => searchInput.focus(), 50);
    }

    function closeModal() {
        modal.style.display = 'none';
    }

    document.querySelectorAll('.btn-open-search').forEach(b => {
        b.addEventListener('click', openModal);
    });
    document.getElementById('btn_close_modal').addEventListener('click', closeModal);
    document.getElementById('btn_close_modal_footer').addEventListener('click', closeModal);
    modal.addEventListener('click', function (e) {
        if (e.target === modal) closeModal();
    });

    searchInput.addEventListener('input', function () {
        renderSearchResults(this.value.trim().toLowerCase());
    });

    function renderSearchResults(query) {
        let filtered = allProperties;
        if (query) {
            filtered = allProperties.filter(p => {
                return (p.term && p.term.toLowerCase().includes(query)) ||
                       (p.label && p.label.toLowerCase().includes(query)) ||
                       (p.vocab && p.vocab.toLowerCase().includes(query));
            });
        }

        if (filtered.length === 0) {
            searchResults.innerHTML = `<div style="padding: 24px; text-align: center; color: #888;">Nessuna proprietà corrisponde alla ricerca: "${escapeHtml(query)}"</div>`;
            return;
        }

        let html = '<div style="display: flex; flex-direction: column; gap: 8px;">';
        filtered.slice(0, 100).forEach(p => {
            const isAlreadyAdded = !!currentFields[p.term];
            html += `
                <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px 14px; border: 1px solid #eee; border-radius: 4px; background: ${isAlreadyAdded ? '#f9f9f9' : '#fff'};">
                    <div style="flex: 1; padding-right: 12px;">
                        <div style="font-weight: bold; font-size: 14px; color: ${isAlreadyAdded ? '#888' : '#222'};">
                            ${escapeHtml(p.label)}
                        </div>
                        <div style="font-size: 12px; margin-top: 2px;">
                            <code style="color: #1e3a8a; font-weight: 600;">${escapeHtml(p.term)}</code>
                            ${p.vocab ? `<span style="margin-left: 8px; color: #777; font-size: 11px; background: #eaeaea; padding: 1px 6px; border-radius: 3px;">${escapeHtml(p.vocab)}</span>` : ''}
                        </div>
                    </div>
                    <div>
                        ${isAlreadyAdded ? 
                            '<span style="color: #2e7d32; font-weight: bold; font-size: 12px;">✓ Aggiunto</span>' : 
                            `<button type="button" class="button button-primary btn-add-prop" data-term="${escapeHtml(p.term)}" data-label="${escapeHtml(p.label)}" style="padding: 4px 12px; font-size: 12px;">+ Aggiungi</button>`
                        }
                    </div>
                </div>
            `;
        });
        if (filtered.length > 100) {
            html += `<div style="text-align: center; color: #888; font-size: 12px; padding: 8px;">Mostrati 100 risultati su ${filtered.length}. Digita per affinare la ricerca.</div>`;
        }
        html += '</div>';

        searchResults.innerHTML = html;

        searchResults.querySelectorAll('.btn-add-prop').forEach(btn => {
            btn.addEventListener('click', function () {
                const term = this.getAttribute('data-term');
                const label = this.getAttribute('data-label') || term;
                currentFields[term] = label;
                syncFields();
                // Ricarica la vista dei risultati per aggiornare lo stato del pulsante
                renderSearchResults(searchInput.value.trim().toLowerCase());
            });
        });
    }

    function escapeHtml(str) {
        if (!str) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }
});
</script>
